// Version: 1.0.0
FUNCTION sum()->int
    SET total<int> = 0
    FOR
        SET i<int> = 1;
        GET i < 5;
        SET i = GET i + 1
    THEN
        IF GET i == 2 THEN
            CONTINUE
        END
        IF GET i == 4 THEN
            BREAK
        END
        SET total = GET total + GET i
    END
    RETURN GET total
END
CALL println value<int>:CALL sum END END
