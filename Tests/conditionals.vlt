// ============================================================
// ValtCommand - Conditional Tests
// ============================================================

CALL println value<str>:"========== BASIC IF ==========" END

IF 5 > 3 THEN
    CALL println value<str>:"IF passed" END
END

CALL println value<str>:"========== IF / ELSE ==========" END

IF 5 < 3 THEN
    CALL println value<str>:"Unexpected branch" END
ELSE THEN
    CALL println value<str>:"ELSE passed" END
END

CALL println value<str>:"========== AND CONDITION ==========" END

IF (5 > 3) && (10 > 2) THEN
    CALL println value<str>:"AND passed" END
ELSE THEN
    CALL println value<str>:"AND failed" END
END

CALL println value<str>:"========== OR CONDITION ==========" END

IF (5 < 3) || (10 > 2) THEN
    CALL println value<str>:"OR passed" END
ELSE THEN
    CALL println value<str>:"OR failed" END
END

CALL println value<str>:"========== NOT CONDITION ==========" END

IF !(5 > 10) THEN
    CALL println value<str>:"NOT passed" END
ELSE THEN
    CALL println value<str>:"NOT failed" END
END

CALL println value<str>:"========== NESTED CONDITIONS ==========" END

IF 10 > 5 THEN
    IF 8 > 3 THEN
        CALL println value<str>:"Nested IF passed" END
    ELSE THEN
        CALL println value<str>:"Inner ELSE executed" END
    END
ELSE THEN
    CALL println value<str>:"Outer ELSE executed" END
END

CALL println value<str>:"========== CONDITIONAL TESTS COMPLETED ==========" END
